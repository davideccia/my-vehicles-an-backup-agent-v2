# ─── APPLICATION ──────────────────────────────────────────────────────────────

APP_NAME=Goravel
# Options: local | production
APP_ENV=local
# Generate with: go run . artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# 0.0.0.0 to accept connections from other devices on the network (e.g. the
# Android app on a phone); 127.0.0.1 only accepts connections from this machine
APP_HOST=0.0.0.0
APP_PORT=3000

# ─── LOGGING ───────────────────────────────────────────────────────────────────

LOG_CHANNEL=stack
# Options: debug | info | warning | error
LOG_LEVEL=debug

# ─── SESSION ───────────────────────────────────────────────────────────────────

SESSION_DRIVER=file
# Session lifetime in minutes
SESSION_LIFETIME=120

# ─── DATABASE ──────────────────────────────────────────────────────────────────

# Options: sqlite | postgres | mysql
DB_CONNECTION=sqlite
# Used by postgres/mysql only
DB_HOST=127.0.0.1
DB_PORT=5432
# postgres/mysql: database name. sqlite: file path (relative to project root).
# The parent directory (storage/database/) must exist beforehand — the
# sqlite driver doesn't create it. It's also its own bind mount target in
# compose.yml, kept separate from the rest of storage/ (logs, etc.).
DB_DATABASE=storage/database/database.sqlite
# Used by postgres/mysql only
DB_USERNAME=goravel
DB_PASSWORD=goravel
# Used by postgres only
DB_SCHEMA=public

# ─── BACKUP AGENT ──────────────────────────────────────────────────────────────

# Shared secret required on the `x-api-key` header for every route but
# /ping and /healthcheck
API_KEY=changeme

# ─── AUTHENTICATION ────────────────────────────────────────────────────────────

# Generate with: go run . artisan jwt:secret. Unused by the backup agent
# itself, kept from the Goravel scaffold.
JWT_SECRET=

# ─── AI ────────────────────────────────────────────────────────────────────────

# Unused by the backup agent itself, kept from the Goravel scaffold
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ─── GRPC ──────────────────────────────────────────────────────────────────────

# Unused by the backup agent itself, kept from the Goravel scaffold
GRPC_HOST=
GRPC_PORT=

# ─── MAIL ──────────────────────────────────────────────────────────────────────

# Unused by the backup agent itself, kept from the Goravel scaffold
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
