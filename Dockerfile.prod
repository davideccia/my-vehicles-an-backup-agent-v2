FROM golang:1.25-alpine AS builder

ENV GO111MODULE=on \
    CGO_ENABLED=0

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build --ldflags "-s -w -extldflags -static" -o main .

FROM alpine:3.21

RUN apk add --no-cache wget \
    && addgroup -g 1001 -S appgroup \
    && adduser -S appuser -u 1001 -G appgroup

WORKDIR /www

COPY --from=builder --chown=appuser:appgroup /build/main /www/
COPY --from=builder --chown=appuser:appgroup /build/public/ /www/public/
COPY --from=builder --chown=appuser:appgroup /build/resources/ /www/resources/
COPY --chown=appuser:appgroup entrypoint.sh /www/entrypoint.sh

# Config/secrets are NOT baked in: supply them at runtime via env vars
# (e.g. `docker run --env-file .env` or an orchestrator's secrets store).
RUN mkdir -p /www/storage/logs /www/storage/database \
    && chown -R appuser:appgroup /www/storage \
    && chmod +x /www/entrypoint.sh

USER appuser

# Hits GET /healthcheck (unauthenticated, unversioned — unlike /ping) on the
# port baked into APP_PORT (default 3000, see config/http.go).
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/healthcheck || exit 1

# Runs pending migrations, then execs the server so it becomes PID 1
# (correct signal handling for `docker stop`).
ENTRYPOINT ["/www/entrypoint.sh"]
